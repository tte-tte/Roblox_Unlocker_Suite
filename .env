APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/roblox_manager.db
ACCOUNTS_FILE_PATH=data/accounts.txt
PROXIES_FILE_PATH=data/proxies.txt
OUTLOOKS_FILE_PATH=data/outlooks.txt
SCREENSHOTS_DIR=data/screenshots

BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
MAX_CONCURRENT_BROWSERS=1
PRESS_AND_HOLD_DURATION_SEC=5.8

ROBLOX_LOGIN_URL=https://www.roblox.com/login
ROBLOX_NOT_APPROVED_PATH=/not-approved
ROBLOX_HOME_PATH=/home

SELECTOR_USERNAME_INPUT=input[id="login-username"]
SELECTOR_PASSWORD_INPUT=input[id="login-password"]
SELECTOR_LOGIN_BUTTON=button[id="login-button"]
SELECTOR_COOKIE_BANNER_ACCEPT=button.btn-cta-lg.cookie-btn.btn-primary-md
SELECTOR_ARKOSE_IFRAME=iframe[id="arkose-iframe"], iframe[src*="arkoselabs"], iframe[src*="funcaptcha"], iframe[title*="Verification"]
SELECTOR_LOCKED_MODAL_CONTINUE=div.modal-content button.btn-primary-md, button:has-text("Continue")
SELECTOR_AGREEMENT_BUTTON=button:has-text("I Agree")
SELECTOR_QR_MODAL_CONTAINER=div.modal-content, div[role="dialog"]